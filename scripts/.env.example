# ============================================================
# J4P SYSTEM — Environment Variables
# Kopioi tämä: cp .env.example .env
# ÄLÄ KOSKAAN commitoi .env tiedostoa!
# ============================================================

# --- AI APIs ---
ANTHROPIC_API_KEY=            # claude.ai → Settings → API Keys
GEMINI_API_KEY=               # aistudio.google.com (jpelkonen88@gmail.com) → Get API Key
GROQ_API_KEY=                 # console.groq.com → API Keys (ILMAINEN Whisper!)
OPENAI_API_KEY=               # platform.openai.com (varasuunnitelma Whisperille)

# --- Notion ---
NOTION_API_KEY=               # notion.so → Settings → My connections → Create integration
NOTION_PARENT_PAGE_ID=        # Notion-sivun URL: notion.so/[ID] → kopioi ID

# Nämä luodaan notion/setup.py-ajolla automaattisesti:
NOTION_AREAS_DB_ID=
NOTION_COMPANIES_DB_ID=
NOTION_CONTACTS_DB_ID=
NOTION_IDEAS_DB_ID=
NOTION_CRM_DB_ID=
NOTION_ENERGY_LOG_DB_ID=
NOTION_LEGAL_CASE_DB_ID=
NOTION_MARKET_SIGNALS_DB_ID=
NOTION_PRODUCTS_CATALOG_DB_ID=
NOTION_AGENT_COMMS_DB_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=           # @BotFather → /newbot
TELEGRAM_CHAT_ID=             # Oma chat-ID: lähetä /start @userinfobot

# --- Garmin (korvaa Oura) ---
GARMIN_EMAIL=                 # Garmin Connect -sähköposti
GARMIN_PASSWORD=              # Garmin Connect -salasana
# Vaihtoehto: garmin-givemydata SQLite-tietokanta
GARMIN_DB_PATH=/data/garmin.db   # polku garmin-givemydata SQLite:een
# Manuaali-fallback: /health 65 good 72 Telegramissa

# --- n8n ---
N8N_WEBHOOK_URL=              # n8n:n webhook-URL (esim. https://n8n.sinunpalvelin.com)
N8N_BASIC_AUTH_USER=          # n8n perustunnistus (jos käytössä)
N8N_BASIC_AUTH_PASSWORD=      # n8n perustunnistus

# --- Google APIs ---
GOOGLE_SHEETS_ID=             # HIANO CRM Sheets URL:sta
GOOGLE_MAPS_API_KEY=          # console.cloud.google.com → APIs → Maps API (HIANO-kartalle)
GOOGLE_CALENDAR_ID=           # Google Calendar ID (oletuksena: primary)

# --- E-commerce ---
# Lemon Squeezy (digituotteet)
LEMON_SQUEEZY_API_KEY=        # app.lemonsqueezy.com → Settings → API
LEMON_SQUEEZY_STORE_ID=       # Store ID
LEMON_SQUEEZY_WEBHOOK_SECRET= # Webhook secret

# Shopify (Masan Pressu)
SHOPIFY_SHOP_DOMAIN=          # esim. masanpressu.myshopify.com
SHOPIFY_ACCESS_TOKEN=         # Shopify Admin → Settings → Apps → API credentials

# --- Market Intelligence ---
REDDIT_CLIENT_ID=             # reddit.com/prefs/apps → Create app (ILMAINEN)
REDDIT_CLIENT_SECRET=         # Reddit app secret
PRODUCT_HUNT_TOKEN=           # api.producthunt.com (ILMAINEN developer token)

# --- Canva ---
CANVA_CLIENT_ID=              # Canva Developers → Create integration
CANVA_CLIENT_SECRET=          # Canva integration secret

# ============================================================
# GOOGLE CLOUD (lisää myöhemmin jos tarvitaan skaalaus)
# ============================================================
# GOOGLE_CLOUD_PROJECT_ID=    # Google Cloud Console → Project ID
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_DATABASE_URL=      # Firebase Realtime DB URL (agenttiviestibussi)

# ============================================================
# KUSTANNUSARVIO (kuukausittain)
# n8n VPS: ~5€ | Gemini: 0€ | Claude: ~10-30€ | Shopify: $29
# Groq Whisper: 0€ | Notion: 0€ | Lemon Squeezy: 0€ + 5%
